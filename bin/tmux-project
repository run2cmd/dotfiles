#!/bin/bash
# Fuzzy project opener - lists /code dirs and opens/switches to a tmux session.
# Bind in tmux.conf with:
#   bind p display-popup -E "~/bin/tmux-project"

list_projects() {
    # /code/<org>/<repo> shown as "org/repo"; /home entries shown as-is
    for d in /code/*/*/; do
        d=${d%/}
        echo "${d#/code/}"
    done
    ls -1 /home
}

selected=$(list_projects | fzf \
    --prompt="project> " \
    --header="Open project session" \
    --reverse \
    --height=100% \
    --border=none)

[ -z "$selected" ] && exit 0

# tmux session names cannot contain '.' or ':'
session_name=${selected//[.:]/_}
if [ -d "/code/$selected" ]; then
    project_path="/code/$selected"
else
    project_path="/home/$selected"
fi

if tmux has-session -t "=$session_name" 2>/dev/null; then
    tmux switch-client -t "=$session_name"
else
    tmux new-session -d -s "$session_name" -c "$project_path"
    tmux switch-client -t "=$session_name"
fi
